# 复制为 .env。勿提交真实密码。

COMPOSE_PROJECT_NAME=stock-mysql
TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=stock_data
MYSQL_USER=stock
MYSQL_PASSWORD=change-me

# 已有 ~/dev/docker/mysql 数据目录可原样复用（零迁移）
MYSQL_DATA_DIR=/Users/yolo/dev/docker/mysql/data
MYSQL_CONF_DIR=/Users/yolo/dev/docker/mysql/conf.d
MYSQL_LOG_DIR=/Users/yolo/dev/docker/mysql/logs

# stock-ai / investment-agent 连接串（与 stock-ai/.env 对齐）
# MYSQL_URL=mysql+pymysql://stock:change-me@127.0.0.1:3306/stock_data
