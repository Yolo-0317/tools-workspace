{
  "episode": "ep04",
  "theme": "雨",
  "theme_slug": "rain",
  "audio_slug": "ep04-rain",
  "lines": [
    {
      "id": "01-opening",
      "role": "ayan",
      "text": "飞花令，雨。",
      "start_ms": 0
    },
    {
      "id": "02-poem-01",
      "role": "zhixia",
      "text": "好雨知时节，当春乃发生。"
    },
    {
      "id": "03-poem-02",
      "role": "ayan",
      "text": "清明时节雨纷纷，路上行人欲断魂。"
    },
    {
      "id": "04-poem-03",
      "role": "zhixia",
      "text": "寒雨连江夜入吴，平明送客楚山孤。"
    },
    {
      "id": "05-outro",
      "role": "ayan",
      "text": "雨停了，诗意未歇。第四句，你来接。",
      "gap_before_ms": 150
    }
  ]
}
