[
  {
    "id": "01-opening",
    "text": "飞花令，秋。会的先别说。",
    "start": 0.0,
    "end": 3.24,
    "highlight": "秋"
  },
  {
    "id": "02-poem-01",
    "text": "树树皆秋色，山山唯落晖。",
    "start": 3.36,
    "end": 7.224,
    "highlight": "秋"
  },
  {
    "id": "03-poem-02",
    "text": "秋风生渭水，落叶满长安。",
    "start": 7.8,
    "end": 10.848,
    "highlight": "秋"
  }
]
