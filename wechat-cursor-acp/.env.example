# Cursor Agent 工作目录（相对本目录或绝对路径）
AGENT_CWD=../stock-ai/investment-agent

# wechat-acp 多实例名（状态目录：~/.wechat-acp/instances/<name>/）
WECHAT_ACP_INSTANCE=tools-workspace

# 1=关闭 wechat-acp 遥测
WECHAT_ACP_TELEMETRY=0

# 1=把 Agent 思考摘要转发到微信（💭 [Thinking] 前缀，消息较多）
WECHAT_FORWARD_THOUGHTS=0

# 微信 Agent 模型（默认 composer-2.5；额度不足时可改为 auto）
WECHAT_AGENT_MODEL=composer-2.5
