# 单服务（launchd 登录自启）
# 0.0.0.0 = 本机 127.0.0.1 + 局域网；勿用 localhost（macOS 可能走 IPv6 连不上）
HUB_HOST=0.0.0.0
HUB_PORT=8780
HUB_API_TOKEN=

# 登录鉴权（内置账号，写在 .env 勿提交）
HUB_REQUIRE_AUTH=1
HUB_ADMIN_USER=admin
HUB_ADMIN_PASSWORD=changeme
HUB_SHARE_USER=share
HUB_SHARE_PASSWORD=changeme
HUB_SESSION_TTL_HOURS=168
# 公网 HTTPS 反代时设为 1
HUB_SESSION_COOKIE_SECURE=0

# 公开财经 API 防护（/api/dashboard/news/*，无需登录）
HUB_TRUST_PROXY=1
HUB_NEWS_PUBLIC_GUARD=1
HUB_NEWS_RATE_PER_MIN=45
HUB_NEWS_RATE_BURST=12
HUB_NEWS_RATE_BURST_WINDOW=10
HUB_NEWS_STRICT_PER_MIN=8
HUB_NEWS_AUTH_RATE_PER_MIN=120
HUB_NEWS_MAX_LIMIT=100
HUB_NEWS_ALLOWED_HOSTS=127.0.0.1,localhost,hub.yoloworld.site
