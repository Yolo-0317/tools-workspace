[
  {
    "id": "01-zhixia-line-one",
    "text": "吴刀剪彩缝舞衣。",
    "start": 0.0,
    "end": 2.448,
    "highlight": "雪袖白纻十五秒四句诗朗诵"
  },
  {
    "id": "02-zhixia-line-two",
    "text": "明妆丽服夺春晖。",
