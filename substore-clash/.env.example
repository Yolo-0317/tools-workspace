# 复制为 .env 后填写。勿提交真实订阅 URL。

COMPOSE_PROJECT_NAME=substore-clash
TZ=Asia/Shanghai

# Sub-Store 后端 API 路径前缀（随机字符串，与 UI 中 ?api= 一致）
SUB_STORE_FRONTEND_BACKEND_PATH=/change-me-to-random-string

# 机场订阅（Clash / V2Ray 链接均可，生成器会拉取并解析节点）
# 西部世界、一元机场 — 多个用 | 分隔
SUBSCRIPTION_URLS=

# 若已在 Sub-Store 合并为 collection，可只填这一条（优先于 SUBSCRIPTION_URLS）
# 例: http://sub-store:3001${SUB_STORE_FRONTEND_BACKEND_PATH}/download/collection/all?target=ClashMeta
SUBSTORE_COLLECTION_URL=

# 节点名前缀（与 SUBSCRIPTION_URLS 顺序对应，用 | 分隔）
SUB_SOURCE_LABELS=西部世界|一元机场

# clash-gen 监听
CLASH_GEN_PORT=8787
# 对外订阅 token（留空则仅内网使用）
CLASH_SUB_TOKEN=

# 对外订阅（须带 EXTERNAL_HTTPS_PORT，与 sidestore-infra 一致）
PUBLIC_CLASH_URL=https://sub.yoloworld.site:8883/clash.yaml
CLASH_SUBDOMAIN=sub
DOMAIN=yoloworld.site
