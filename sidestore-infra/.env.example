# sidestore-infra — 详见 README.md
# 复制为 .env 后填写。密钥放 .env.secrets（勿提交 git）

TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=sidestore-infra

# 主域名与子域前缀
DOMAIN=yoloworld.site
ANI_SUBDOMAIN=ani
CONFIG_SUBDOMAIN=config
ALIST_SUBDOMAIN=alist
WWW_SUBDOMAIN=www
SUB_SUBDOMAIN=sub
HUB_SUBDOMAIN=hub

# Let's Encrypt 注册邮箱（acme.sh）
ACME_EMAIL=you@example.com

# HTTPS 端口：Caddy 监听 443，映射到宿主机两个端口
# 内网/本机用 INTERNAL；路由器外网映射 EXTERNAL -> INTERNAL
INTERNAL_HTTPS_PORT=8443
EXTERNAL_HTTPS_PORT=8883

# anisette 本机调试端口（仅 loopback）
ANISETTE_PORT=6969

# 阿里云 DDNS 同步的子域（逗号分隔，须与证书 SAN 一致）
DDNS_SUBDOMAINS=ani,config,alist,www,sub,hub
# 家里路由器 WAN 公网 IP（与路由器管理页一致）；设后 DDNS 不随热点/代理漂移
# DDNS_PUBLIC_IP=58.37.2.150

# 阿里云 API 密钥见 .env.secrets：
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
