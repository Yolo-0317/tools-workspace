# stock-ai 统一调度（supercronic + Asia/Shanghai）
# 纯 MySQL/Tushare 在容器内；OpenCLI / 微信走 run-host-job.sh → 本机 host_job_server

SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# 工作日 17:00 Tushare → MySQL
0 17 * * 1-5 /bin/sh /app/run_sync_daily.sh >> /app/logs/sync_daily.log 2>&1

# 工作日 17:30 选股 + SOP + 战报（本机 OpenCLI）
30 17 * * 1-5 /bin/sh /app/docker/scheduler/run-host-job.sh selection >> /app/logs/selection.log 2>&1

# 每日战报（本机 OpenCLI）
0 9 * * * /bin/sh /app/docker/scheduler/run-host-job.sh briefing 09:00 >> /app/logs/briefing.log 2>&1
0 12 * * * /bin/sh /app/docker/scheduler/run-host-job.sh briefing 12:00 >> /app/logs/briefing.log 2>&1
0 15 * * * /bin/sh /app/docker/scheduler/run-host-job.sh briefing 15:00 >> /app/logs/briefing.log 2>&1
0 20 * * * /bin/sh /app/docker/scheduler/run-host-job.sh briefing 20:00 >> /app/logs/briefing.log 2>&1

# 盘中监控（本机 OpenCLI；非交易时段脚本内跳过）
*/5 * * * 1-5 /bin/sh /app/docker/scheduler/run-host-job.sh monitor >> /app/logs/monitor.log 2>&1
