OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# ── TTS ──────────────────────────────────────────────
# edge=微软神经音（联网，默认）· piper=离线
TTS_ENGINE=edge
TTS_VOICE=en-US-JennyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
# 艾莎：Emma=活泼清晰 · 奥特曼：Guy
ELSA_EDGE_VOICE=en-US-EmmaMultilingualNeural
ULTRA_EDGE_VOICE=en-US-GuyNeural
# 离线 Piper（TTS_ENGINE=piper 时）
PIPER_LENGTH_SCALE=1.0

# 生产前端 base=/english/；直连 http://127.0.0.1:18787/english/ 时需要
ENGLISH_BUDDY_URL_PREFIX=/english
# ENGLISH_BUDDY_HOST=0.0.0.0   # 仅 HTTP 调试；手机麦克风须 HTTPS
# 内网手机带读: ./scripts/setup-lan-https.sh → https://<局域网IP>:8443/english/
# ENGLISH_BUDDY_COOKIE_SECURE=0  # 仅本地 HTTP dev；HTTPS 须为 1（默认）

# ── 内置课文预热 ─────────────────────────────────────
# 启动后后台并发预热（艾莎/奥特曼 × 慢/标准/快）；0=关闭
BUILTIN_PREWARM=1
BUILTIN_PREWARM_CONCURRENCY=4

# ── 家庭账号（自定义课文按用户隔离；不开放注册）──────
# 逗号分隔 user:password；改后 restart 生效（会更新密码）
ENGLISH_BUDDY_USERS=dad:changeme,mom:changeme2
# 仅这些用户名启用麦克风识别；未登录或其他账号只听老师带读（留空=所有人可识别）
# ENGLISH_BUDDY_STT_USERS=yueyue,dingdang
# 仅列出的用户名显示「自由聊天」；留空=所有人不可见
# ENGLISH_BUDDY_FREE_CHAT_USERS=yueyue,dingdang
# 可选，与 USERS 合并（同名时后者覆盖）
# ENGLISH_BUDDY_ADMIN_USER=dad
# ENGLISH_BUDDY_ADMIN_PASSWORD=changeme
ENGLISH_BUDDY_REQUIRE_AUTH=1
ENGLISH_BUDDY_SESSION_TTL_HOURS=720
# Cookie 路径须与前端 BASE_URL 一致：
#   公网 /english/  → /english/
#   本地 dev        → /  （同时 frontend/.env VITE_BASE_PATH=/）
ENGLISH_BUDDY_COOKIE_PATH=/english/
# ENGLISH_BUDDY_COOKIE_SECURE=1
# ENGLISH_BUDDY_COOKIE_SAMESITE=lax

# ── 带读发音标记（绿/黄/橙）────────────────────────────
# 1=开启；gentle=只标记不拦进度（M1 默认）
PRONUNCIATION_ASSESS=1
# 仅影响历史配置；带读始终进入下一句（颜色仅作提示）
PRONUNCIATION_STRICTNESS=gentle
# normal 时「再练」句不自动跳下一句

# ── 教学法 ───────────────────────────────────────────
TEACHING_GUIDE=1
# TEACHING_GUIDE_PATH=backend/teaching/playbook_age4_read_along.md

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://192.168.1.13:8443,https://hub.yoloworld.site:8883,https://hub.yoloworld.site:8443

# ── Whisper STT ──────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
# 并行识别路数（每路独立模型实例，约 +500MB 内存/路；家庭 2 人跟读建议 2）
WHISPER_WORKERS=2
# 带读/听读总并发上限（默认与 WHISPER_WORKERS 一致；听读为主可设 4–8）
# MAX_READ_ALONG_SESSIONS=6

# 登录用户带读诊断日志 → logs/call-sessions.jsonl（0=关闭）
# CALL_SESSION_LOG=1
# 同时自由聊天人数上限（默认 2）
# MAX_FREE_CHAT_SESSIONS=2
