# Cursor Agent：agent login + agent acp（同 wechat-acp）
HUB_AGENT_MODEL=auto
HUB_AGENT_CWD=/Users/yolo/dev/yolo/tools-workspace/stock-ai/investment-agent
HUB_FORWARD_THOUGHTS=0

# ACP 单轮 prompt 超时（秒），复杂任务可调大
HUB_ACP_PROMPT_TIMEOUT=600

# 单服务（launchd 登录自启）
# 0.0.0.0 = 本机 127.0.0.1 + 局域网；勿用 localhost（macOS 可能走 IPv6 连不上）
HUB_HOST=0.0.0.0
HUB_PORT=8780
HUB_API_TOKEN=

# 聊天限制
HUB_CHAT_RATE_LIMIT=10
HUB_SESSION_IDLE_HOURS=24

# 登录鉴权（内置账号，写在 .env 勿提交）
HUB_REQUIRE_AUTH=1
HUB_ADMIN_USER=admin
HUB_ADMIN_PASSWORD=changeme
HUB_SHARE_USER=share
HUB_SHARE_PASSWORD=changeme
HUB_SESSION_TTL_HOURS=168
# 公网 HTTPS 反代时设为 1
HUB_SESSION_COOKIE_SECURE=0
