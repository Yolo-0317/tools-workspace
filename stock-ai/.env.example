# 复制为 .env 并填写真实值（勿提交 .env）
TUSHARE_TOKEN=

# 本机直连 MySQL（库 stock_data，服务见 ../stock-mysql/）
MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/stock_data

# Docker 定时任务（docker/scheduler）若 MySQL 在宿主机，请用：
# MYSQL_URL=mysql+pymysql://user:password@host.docker.internal:3306/stock_data

# Docker scheduler → 本机 OpenCLI 任务（见 docs/SCHEDULING.md）
# HOST_JOB_PORT=9876
# HOST_JOB_TOKEN=
# HOST_JOB_BIND=127.0.0.1

# OpenCLI 浏览器：单会话 + 单窗复用标签（fetch_eastmoney_quotes 默认）
# 可选：程序会依次从 PATH 和 ~/.nvm/versions/node/*/bin 自动发现
# OPENCLI_BIN=/absolute/path/to/opencli
# OPENCLI_BROWSER_SESSION=stock          # 东财/快讯等自动化；搜一搜 bind 用 mp（脚本内写死）
# OPENCLI_BROWSER_WINDOW=background      # foreground|background；none=不传 --window
# OPENCLI_BROWSER_IF_EXISTS=navigate     # 默认同标签跳转；勿用 tab（易堆 Chrome 标签分组）
# OPENCLI_BROWSER_CLOSE_TABS_ON_RELEASE=1  # 任务结束关会话内全部 tab 再 release lease
# OPENCLI_BROWSER_CLOSE_PREV_TAB=1       # 仅 IF_EXISTS=tab 时：tab new 后关上一标签
# OPENCLI_BROWSER_REUSE_TAB=1            # 仅影响批次是否 force reset；导航见 IF_EXISTS
# OPENCLI_BROWSER_NEW_TAB=0              # 1=强制有窗时 tab new（等同 IF_EXISTS=tab）
# OPENCLI_BROWSER_FORCE_RESET=0          # 1=批次开始前仍 force close
# OPENCLI_BROWSER_CLEANUP_SESSIONS=stock,default,mp

# LLM：写稿/战报默认 Cursor；东财 SOP 并发终审固定 DeepSeek API
LLM_BACKEND=cursor
CURSOR_AGENT_MODEL=composer-2.5
SOP_LLM_BACKEND=deepseek
DEEPSEEK_API_KEY=
# 公众号写稿：固定 Composer（call_wechat_mp_llm）；东财 SOP 终审仍用 DeepSeek API
# WECHAT_MP_LLM_MODEL=composer-2.5   # 覆盖 CURSOR_AGENT_MODEL
# WECHAT_MP_CURSOR_MAX_RETRIES=1      # agent 失败重试（默认 1，省时间）
# WECHAT_MP_CURSOR_TIMEOUT_SECONDS=420
# WECHAT_MP_HOTSPOT_IMITATE_REWRITE=0 # 热点深评二次仿写（默认关，省一轮 LLM）
# WECHAT_MP_HOTSPOT_MAX_ATTEMPTS=1    # 社会热点成稿默认 1 轮；人工排障时可临时设为 2
# WECHAT_MP_HOTSPOT_MIN_BODY_SLACK=200 # 社会热点字数容差（门禁 2000-200=1800）
# DEEPSEEK_MODEL=deepseek-v4-flash
# SOP 并发：DEEPSEEK_WORKERS=3（OpenCLI 采集与 LLM 分离；勿对 SOP 设 LLM_BACKEND=cursor）
# Top5 东财 SOP（17:45 选股链路）：公众号 evening 已不依赖，默认关
DISABLE_SOP_TOP5=1
# 收盘甄选战报落盘 output/daily_selection_full_latest.txt：默认关
DISABLE_SELECTION_REPORT=1

# 每日选股战报（push_selection_wechat.sh）：默认只写 output/daily_selection_full_latest.txt，不推微信
# PUSH_WECHAT=1
# WECHAT_PUSH_BACKEND=wechat-acp
# WECHAT_ACP_INSTANCE=tools-workspace
# WECHAT_TARGET=o9cq801H5ip_q8SH3ogvkQhhNI2s@im.wechat

# 持仓盘中监控（默认停用；恢复需 HOLDINGS_MONITOR_ENABLED=1 + 取消 crontab monitor 注释）
# HOLDINGS_MONITOR_ENABLED=0
# FEISHU_BOT_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# HOLDINGS_ALERT_FEISHU=1
# HOLDINGS_ALERT_WECHAT=1

# 东财掘金 Win11 终端（Token / 策略 ID / Parallels 地址）
# 东财掘金仿真量化见独立子项目 emquant-sim/（2026-06-02 已下线，EMQUANT_ENABLED=0）

# ── 微信公众号 API（开发者平台 + IP 白名单）────────────────────────────
# 1) https://developers.weixin.qq.com/ 绑定公众号，获取 AppSecret
# 2) 开发管理 → IP 白名单：填家里公网 IP（路由器不重启时一般不变）
# 3) 账号需完成认证后，草稿/发布接口权限才齐全（订阅号）
# WECHAT_MP_APPID=wxe98d64b124ee854e
# WECHAT_MP_SECRET=
# WECHAT_MP_WHITELIST_IP=58.37.x.x
# WECHAT_MP_PUBLIC_IP=              # 可选：固定写死公网 IP，跳过 ipify 探测
# WECHAT_MP_AUTHOR=R2D2
# WECHAT_MP_ACCOUNT_NAME=牛马也智能   # 正文品牌头艺术字名
# WECHAT_MP_BANNER_PATH=             # 默认 assets/wechat_mp/banner.png
# WECHAT_MP_FIGURE_MAX_HEIGHT=200     # 正文插图最大高度 px（默认 200，避免半屏）
# TMDB_READ_ACCESS_TOKEN=             # 可选：影视剧照官方 API；不配也能从 TMDB 公开页抓取
# WECHAT_MP_TV_STILLS_FORCE=1         # 1=强制重下 assets/wechat_mp/inline-tv/<slug>/ 剧照
# WECHAT_MP_TV_SOURCE=mixed           # mixed|trends|curated — 影视选题来源（mixed=热搜+curated）
# WECHAT_MP_TV_TOPIC=凤囚凰           # 指定片名推 tv_review 稿
# WECHAT_MP_TV_RESEARCH=1             # 1=成稿前附热搜语境+东财报道检索
# WECHAT_MP_MASTHEAD=1               # 0=关闭正文品牌头框
# WECHAT_MP_MASTHEAD_SLOGAN=         # 全局 slogan；不设则各槽位用内置俏皮话
# WECHAT_MP_MASTHEAD_SLOGAN_MARKET=  # 覆盖单槽 slogan
# 阅读原文链接（默认不写草稿，发布页不会出现看板外链）
# WECHAT_MP_READ_SOURCE_URL=1
# WECHAT_MP_SOURCE_URL=https://hub.yoloworld.site:8883/news
# 增长模型 · stock-ai 引流（见 data/wechat_mp_growth_focus.json stock_ai_cta）
# WECHAT_MP_STOCK_AI_CTA=1
# WECHAT_MP_STOCK_AI_HUB_URL=https://hub.yoloworld.site:8883
# WECHAT_MP_STOCK_AI_CTA_KINDS=news,dragons,sector
# WECHAT_MP_AUTO_PUBLISH=0          # 1=草稿后直接 freepublish（建议先 0，人工审）
# WECHAT_MP_MONETIZE=1              # 0=关闭 LLM 流量块 + 文末问句 + 推荐♡引导
# WECHAT_MP_VERTICAL_WORDS_MIN=2     # traffic 清单：正文垂直词最少命中数（见 monetization.VERTICAL_HINTS_BY_KIND）
# WECHAT_MP_ENGAGEMENT_HOOK=1       # 0=不加文末互动问句
# WECHAT_MP_RECOMMEND_HOOK=1        # 0=不加「推荐 ♡」引导（朋友推荐流）
# WECHAT_MP_NEED_OPEN_COMMENT=1     # 1=草稿打开留言（默认开）
# WECHAT_MP_ONLY_FANS_COMMENT=0     # 1=仅粉丝可留言
# WECHAT_MP_STRICT_COMPLIANCE=1     # 1=合规未过则不推草稿；0=仅告警仍推送
# 广告：流量主开通后微信发布时自动插底部/文中广告，正文无需留位
# WECHAT_MP_AD_CHECKPOINT=1         # 极少用：正文插 · · · 标记（默认关）
# 文末返佣商品（需已开通「返佣商品和内容推广」）
# WECHAT_MP_FOOTER_PRODUCT=0        # 1=草稿文末插入 mp-common-cpsad 返佣商品
# WECHAT_MP_DAIHUO_UIN=             # 选品页 Select 请求的 uin（浏览器 Network 复制）
# WECHAT_MP_FOOTER_PRODUCT_AUTO_PICK=1  # 1=每次推稿前 Select 自动选品（FOOTER=1 时默认开）
# WECHAT_MP_PICK_STRATEGY=sales       # sales=销量优先(默认) | balanced=销量门槛+佣金 | commission=仅佣金
# WECHAT_MP_PICK_MIN_SALES=500        # balanced/sales 时优先销量≥此值的商品（无则 balanced 回退）
# WECHAT_MP_FOOTER_PRODUCT_ID=      # 手动固定商品；auto-pick 开启时会被覆盖
# WECHAT_MP_FOOTER_PICK_KEYWORD=    # 覆盖全部槽位搜索词（空格分隔多词）
# WECHAT_MP_FOOTER_PICK_KEYWORD_DEFAULT=充电宝  # 无槽位映射时的 fallback
# WECHAT_MP_FOOTER_PRODUCT_CARD_TYPE=1  # getcardinfo：0大卡 1小卡 2文字链 3条卡
# WECHAT_MP_FOOTER_PRODUCT_KINDS=market,top5  # 空=全部槽位；完读优先少插 sector/dragons
# 选品：uv run python -m scripts.tools.wechat_mp_product --search 机械键盘
# 手动选：uv run python -m scripts.tools.wechat_mp_product --pick --pick-keyword 充电宝
# 验证：uv run python -m scripts.tools.wechat_mp_product --verify <product_id>
# 带货种草稿（独立于五槽）：uv run python -m scripts.tools.wechat_mp_commerce_draft --help
# WECHAT_MP_COMMERCE_HUMANIZE=0
# WECHAT_MP_COMMERCE_MASTHEAD=1       # 默认开：简选小电 banner（assets/wechat_mp/commerce/banner.png）
# WECHAT_MP_COMMERCE_BANNER_PATH=     # 覆盖顶栏；默认 commerce/banner 或 ~/Pictures/简选小电banner.png
# WECHAT_MP_COMMERCE_THUMB_PATH=      # 草稿封面；默认 commerce/avatar 或 ~/Pictures/简选小电头像.png
# WECHAT_MP_COMMERCE_ACCOUNT_NAME=简选小电
# WECHAT_MP_COMMERCE_SEO=1            # 标题/摘要搜一搜词 + 文末 #话题 + 发布提醒
# WECHAT_MP_COMMERCE_AUTO_PUBLISH=0   # 1=带货推稿后 freepublish 直接发表（无原创/#）
# WECHAT_MP_COMMERCE_THUMB=封面-财经屏-双封面   # 仅当未找到本地 avatar 时回退素材库名
# 简选小电独立号（带货稿 wechat_mp_commerce_draft 优先读 COMMERCE_*，未配则回退上方财经号）
# WECHAT_MP_COMMERCE_APPID=wx47f3ff18739ab54a
# WECHAT_MP_COMMERCE_SECRET=              # 公众平台 → 开发 → 基本配置
# WECHAT_MP_COMMERCE_AUTHOR=简选小电       # 可选；草稿作者栏
# 默认垂直 home；槽位见 data/wechat_mp_commerce_slots.json
# WECHAT_MP_THUMB_MEDIA_ID=        # 全局兜底（四槽位默认各用各的，一般不设）
# WECHAT_MP_THUMB_NAME=机器人图     # 全局兜底文件名子串
# 四槽位封面（--list-materials 查看；默认「双封面」竖图）
# WECHAT_MP_THUMB_NAME_SECTOR=封面-牛马品牌-双封面   # 可选：素材库竖图；未命中则自动上传 banner.png
# WECHAT_MP_SECTOR_THUMB_FROM_BANNER=1             # 1=行业封面回退正文品牌头 assets/wechat_mp/banner.png
# WECHAT_MP_SECTOR_THUMB_PATH=                     # 覆盖 sector 封面本地路径（默认同 masthead banner）
# WECHAT_MP_THUMB_NAME_MARKET=封面-交易所屏-双封面
# WECHAT_MP_THUMB_NAME_NEWS=封面-显示器走势-双封面
# WECHAT_MP_THUMB_NAME_TOP5=封面-财经亮屏-双封面
# WECHAT_MP_THUMB_NAME_DRAGONS=封面-多屏亮行情-双封面
# 晚间封面留档：assets/wechat_mp/COVER_THUMBS.md
# top5/dragons 默认上传 repo 亮色封面（1=优先于素材库；改图后删 data/wechat_mp_thumb_{top5,dragons}.json）
# WECHAT_MP_KIND_THUMB_FROM_ASSETS=1
# WECHAT_MP_THUMB_PATH_TOP5=assets/wechat_mp/cover-financial-screen-dual.jpg
# WECHAT_MP_THUMB_PATH_DRAGONS=assets/wechat_mp/cover-multi-screen-dual.jpg
# WECHAT_MP_THUMB_NAME_WORKSPACE=封面-数据大屏-双封面
# 带货封面走 WECHAT_MP_COMMERCE_THUMB / 本地 avatar，勿与上列混用（素材库共用但财经选图会排除 avatar）
# WECHAT_MP_THUMB_MEDIA_ID_MARKET=
# WECHAT_MP_THUMB_INDEX=0
# WECHAT_MP_THUMB_UPLOAD=0
# WECHAT_MP_DRAGON_SLOT=eod        # 龙头稿读取情绪周期时段 pre_market|intraday|eod
# WECHAT_MP_NOTIFY=1               # 分时段推送后通知（0=关）
# WECHAT_MP_NOTIFY_WECHAT=1        # 微信 wechat-acp（需 WECHAT_ACP_INSTANCE / WECHAT_TARGET）
# WECHAT_MP_NOTIFY_FEISHU=1        # 飞书（FEISHU_BOT_URL）
# 定时批次（工作日 launchd，见 docs/WECHAT_MP_SCHEDULING.md）：
#   每日 19:00：交易日 evening → market(close)+top5+dragons(eod)
#               休市日 weekend → news（周末或法定节假日，见 stock_ai/trading_calendar.py）
#   news/workspace/temp 不在定时里，需手动 wechat_mp_draft --kind
# 临时稿槽（单篇可覆写，不占 workspace 总览）:
#   uv run python -m scripts.tools.wechat_mp_draft --kind temp --variant lark_cli
# WECHAT_MP_TEMP_VARIANT=lark_cli
# WECHAT_MP_DRAGON_SOP=1           # 龙头稿是否东财快采（仅公众号，不写 sop_preliminary）
# WECHAT_MP_DRAGON_SOP_MAX=3       # 龙头稿最多分析几只
# WECHAT_MP_DRAGON_SOP_CACHE_HOURS=12  # 快采缓存 output/wechat_mp_dragon_sop/日期/
# WECHAT_MP_DRAGON_SOP_WAIT=1.5    # OpenCLI 页面等待秒数
# WECHAT_MP_TOP5_SOP=1             # Top5 稿东财快采（仅 output/wechat_mp_top5_sop/）
# WECHAT_MP_TOP5_SOP_MAX=5
# WECHAT_MP_TOP5_SOP_CACHE_HOURS=12
# WECHAT_MP_TOP5_SOP_WAIT=1.5
# WECHAT_MP_TOP5_STRATEGIES=combined,five_factor,ma5,watch  # 合并候选后按总分重选 Top5
# WECHAT_MP_TOP5_SCORE_ONLY=1   # 1=按总分优先（不卡「建议动作」白名单）
# WECHAT_MP_READ_HOOKS=1        # 晚间稿完读钩子总开关（sector/dragons/market/news/top5）
# WECHAT_MP_TOP5_READ_HOOKS=1   # 仅 Top5（未设时跟随 READ_HOOKS）
# WECHAT_MP_SECTOR_READ_HOOKS=1
# WECHAT_MP_DRAGONS_READ_HOOKS=1
# WECHAT_MP_MARKET_READ_HOOKS=1
# WECHAT_MP_NEWS_READ_HOOKS=1
# WECHAT_MP_PARA_MAX_CHARS=120    # 全稿单段最大字数，超长自动拆段
# WECHAT_MP_MARKET_NEWS_HOURS=36   # 宏观稿快讯回溯小时数
# WECHAT_MP_MARKET_NEWS_LIMIT=40   # 宏观稿快讯池上限
# WECHAT_MP_MARKET_GEO_LIMIT=8     # 地缘要闻条数
# WECHAT_MP_MARKET_DOMESTIC_LIMIT=14  # 国内要闻条数
# WECHAT_MP_NEWS_SHOW_TIME=0         # 要闻是否带 17:58 钟点（默认 0=不带，更干净）
# WECHAT_MP_NEWS_HOURS=36            # 要闻池回溯小时（平日/手动 news）
# WECHAT_MP_NEWS_TOP=10              # 要闻条数
# 热股 news（evening / weekend 批次自动设 WECHAT_MP_HOT_STOCK_NEWS=1）
# OpenCLI 东财人气榜 TopN × 快讯匹配（不依赖 macro-news 定时 sync）
# WECHAT_MP_WEEKEND_HOT_N=10           # 热股 Top N，各配 1 条快讯
# WECHAT_MP_WEEKDAY_HOT_NEWS_HOURS=36  # 交易日 news 快讯回溯（evening 默认）
# WECHAT_MP_WEEKEND_NEWS_HOURS=48      # 休市日 news 快讯回溯（weekend 默认）
# WECHAT_MP_WEEKEND_KUAIXUN_LIMIT=120  # 快讯池抓取条数
# top5 仍支持手动：uv run python -m scripts.tools.wechat_mp_draft --kind top5
# WECHAT_MP_NEWS_SUMMARY_MIN=230        # 扩写摘要下限（字）
# WECHAT_MP_NEWS_SUMMARY_MAX=250        # 扩写摘要上限（字）
# WECHAT_MP_NEWS_AI_LLM=1               # 要闻 AI 点评/扩写（默认 1=开）
# WECHAT_MP_NEWS_AI_BACKEND=deepseek    # 固定 DeepSeek API，不受 LLM_BACKEND 影响
# WECHAT_MP_NEWS_AI_MIN=190             # AI 点评下限（字，目标约 200）
# WECHAT_MP_NEWS_AI_MAX=210             # AI 点评上限（字）
# WECHAT_MP_MARKET_VIEW_MIN=380        # 结构判断字数下限
# WECHAT_MP_MARKET_VIEW_MAX=520        # 结构判断字数上限
# WECHAT_MP_MARKET_MAX_TOKENS=3200
# 正文插图池（36 张）: uv run python -m scripts.tools.download_wechat_mp_inline_figures
# 当日插图去重: data/wechat_mp_figure_usage.json
# WECHAT_MP_SECTION_STYLE=compact    # 节标题：compact 左线 | card 旧深色引用块

# 自检: uv run python -m scripts.tools.wechat_mp_check_whitelist
# 监控: ./scripts/install-wechat-mp-launchd.sh
# 仅看 IP: uv run python -m scripts.tools.wechat_mp_check_whitelist --show-ip
# 素材库: uv run python -m scripts.tools.wechat_mp_draft --list-materials
# 质量评分: uv run python -m scripts.tools.wechat_mp_eval --kind all
# 预览四篇: uv run python -m scripts.tools.wechat_mp_draft --dry-run
# 进草稿箱: uv run python -m scripts.tools.wechat_mp_draft   # 四槽位：优先改旧稿，再删重复
# 仅工作区技术稿: uv run python -m scripts.tools.wechat_mp_draft --kind workspace
# 临时稿（返佣可选 WECHAT_MP_FOOTER_PRODUCT=1）: ... --kind temp --variant lark_cli
# 只清理: uv run python -m scripts.tools.wechat_mp_draft --prune-only
# 强制新建: uv run python -m scripts.tools.wechat_mp_draft --force-new
# 东财股吧 · 交易日 15:15 launchd（wechat_mp_guba_scheduled.sh）
# WECHAT_MP_GUBA_MODE=hot12          # hot12=人气Top12拆4帖（默认）；sector=行业链
# WECHAT_MP_GUBA_HOT_N=12            # 覆盖 TopN
# WECHAT_MP_GUBA_POSTS=4             # 拆帖数（12÷3）
# WECHAT_MP_GUBA_STOCK_N=4           # sector 模式样本数
# WECHAT_MP_GUBA_MAX_STOCKS_PER_POST=3  # 东财单帖 $话题$ 上限
# WECHAT_MP_GUBA_DRAFT=0            # 15:15 定时默认关；手动 --feishu 可开
# WECHAT_MP_GUBA_USE_CACHE=0        # 定时任务强制刷新；手动可开 1
# WECHAT_MP_GUBA_NOTES=0            # 1=额外写 Mac 备忘录
# WECHAT_MP_GUBA_FEISHU=1           # 1=推飞书（每帖标题+正文各 1 条，共 8 条）
# WECHAT_MP_GUBA_WECHAT=0           # 1=额外推微信（半角 $ 可能被吞）
# WECHAT_MP_GUBA_NOTES_PIN=最新待发  # 备忘录固定标题：东财股吧·最新待发（覆盖更新）
# uv run python -m scripts.tools.wechat_mp_draft --kind guba
# uv run python -m scripts.tools.wechat_mp_guba_sector
# 监控 launchd（API 配好后）: cp ../launchd/com.user.wechat-mp-whitelist-check.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.user.wechat-mp-whitelist-check.plist
# Composer 写稿专用轻量工作区；避免载入 investment-agent 的持仓记忆。
# WECHAT_MP_CURSOR_WORKSPACE=agent-workspaces/wechat-writer
# 热点深评默认只生成一次；人工排障时可临时设为 2。
# WECHAT_MP_HOTSPOT_MAX_ATTEMPTS=1
