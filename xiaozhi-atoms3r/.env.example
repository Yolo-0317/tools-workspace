# ESP-IDF 安装路径（install-idf.sh 默认写入 .espressif/esp-idf-v6.0.2）
IDF_PATH=/Users/yolo/dev/yolo/tools-workspace/xiaozhi-atoms3r/.espressif/esp-idf-v6.0.2

# 小智固件 upstream（setup.sh 会 clone 到 firmware/）
XIAOZHI_FIRMWARE_DIR=firmware

# 板型：AtomS3R CAM 或 AtomS3R M12 + Atomic Echo Base
XIAOZHI_BOARD=atoms3r-cam-m12-echo-base

# 串口（留空则 idf.py 自动探测；macOS 常见 /dev/cu.usbmodem*)
ESPPORT=
