{
	# 证书由 acme.sh + 阿里云 DNS 签发，不走 80/443 HTTP 验证
	auto_https off
	# SideStore 登录走 wss provisioning_session；iOS Starscream 在 HTTP/2 下易失败
	servers :443 {
		protocols h1
	}
}

(tls_le) {
	tls /etc/caddy/certs/fullchain.cer /etc/caddy/certs/key.key
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
	}
}

(wechat_verify) {
	handle /c4de45255be91b51cd4b88b52fb77956.txt {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
}

(ollama_proxy) {
	# Ollama — 宿主机 :11434；须在 encode gzip 之前 import（流式 /api/chat）
	handle /ollama {
		redir * /ollama/ permanent
	}
	handle_path /ollama/* {
		reverse_proxy host.docker.internal:11434 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up Host 127.0.0.1:11434
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
		}
	}
}

(hub_apps) {
	# English Buddy — launchd :18787
	handle /english {
		redir * /english/ permanent
	}
	handle_path /english/* {
		reverse_proxy host.docker.internal:18787 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 旧路径兼容 → HarryPutter
	handle /readalong {
		redir * /harryputter/web/ permanent
	}
	handle_path /readalong/* {
		redir * /harryputter{uri} permanent
	}

	# HarryPutter — launchd :8791（web 静态直出；音频/manifest/API 反代 Python）
	handle /harryputter {
		redir * /harryputter/web/ permanent
	}
	handle /harryputter/web {
		redir * /harryputter/web/ permanent
	}
	handle /harryputter/web/* {
		root * /harryputter
		uri strip_prefix /harryputter
		header Cache-Control "no-cache" /web/index.html
		header Cache-Control "no-cache" /web/sw.js
		file_server
	}
	handle_path /harryputter/* {
		reverse_proxy host.docker.internal:8791 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Home Hub — launchd :8780
	handle /hub {
		redir * /hub/ permanent
	}
	handle_path /hub/* {
		reverse_proxy host.docker.internal:8780 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# SillyTavern — launchd :8792（subpath /silly/；绝对路径 /api /scripts 等见 @st_hub_paths）
	handle /silly {
		redir * /silly/ permanent
	}
	handle_path /silly/* {
		reverse_proxy host.docker.internal:8792 {
			flush_interval -1
			header_down Cache-Control "no-cache"
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Home Hub API（须先于 ST 的 /api/* 匹配）
	@hub_api {
		path /api/auth* /api/services* /api/dashboard*
	}
	handle @hub_api {
		reverse_proxy host.docker.internal:8780 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# ST 在 hub 根路径的静态/API（base href=/ 时 /silly/ 页内资源走 hub 根）
	@st_hub_paths {
		path /login /login*
		path /style.css /manifest.json /favicon.ico /st.ico /st-launcher.ico /robots.txt /script.js /lib.js /jsconfig.json
		path /scripts* /css* /lib* /webpack* /webfonts* /img* /dist*
		path /locales* /sounds*
		path /version /csrf-token /callback* /thumbnail* /proxy*
		path /backgrounds* /characters* /assets* /User* /user*
		path /api/*
		not path /api/auth* /api/services* /api/dashboard*
	}
	handle @st_hub_paths {
		reverse_proxy host.docker.internal:8792 {
			flush_interval -1
			header_down Cache-Control "no-cache"
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	@legacy_hub {
		not path /ollama /ollama/* /english /english/* /harryputter /harryputter/* /readalong /readalong/* /hub /hub/* /silly /silly/*
		not path /c4de45255be91b51cd4b88b52fb77956.txt
	}
	handle @legacy_hub {
		redir * /hub{uri} permanent
	}
}

# --- SideStore ---
https://ani.yoloworld.site {
	import tls_le
	# SideStore 登录走 wss /v3/provisioning_session，勿对 WebSocket 开 gzip
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy anisette:6969 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}
	handle {
		reverse_proxy anisette:6969 {
			transport http {
				read_timeout 60s
			}
		}
	}
	import security_headers
}

https://config.yoloworld.site {
	import tls_le
	encode gzip
	handle /servers.json {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	handle {
		respond 404
	}
}

