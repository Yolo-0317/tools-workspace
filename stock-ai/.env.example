# 复制为 .env 并填写真实值（勿提交 .env）
TUSHARE_TOKEN=

# 本机直连 MySQL（库 stock_data，服务见 ../stock-mysql/）
MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/stock_data

# Docker 定时任务（docker/scheduler）若 MySQL 在宿主机，请用：
# MYSQL_URL=mysql+pymysql://user:password@host.docker.internal:3306/stock_data

# Docker scheduler → 本机 OpenCLI 任务（见 docs/SCHEDULING.md）
# HOST_JOB_PORT=9876
# HOST_JOB_TOKEN=
# HOST_JOB_BIND=127.0.0.1

# LLM：默认 DeepSeek API（可选 LLM_BACKEND=cursor + agent login）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# 若改用 Cursor：LLM_BACKEND=cursor / CURSOR_AGENT_MODEL=auto / SOP_WORKERS=1

# 每日选股战报推送微信（push_selection_wechat.sh）
# WECHAT_PUSH_BACKEND=wechat-acp
# WECHAT_ACP_INSTANCE=tools-workspace
# WECHAT_TARGET=o9cq801H5ip_q8SH3ogvkQhhNI2s@im.wechat
