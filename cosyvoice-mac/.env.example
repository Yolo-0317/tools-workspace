# CosyVoice 模型目录（install.sh 下载后默认路径）
COSYVOICE_MODEL_DIR=pretrained_models/Fun-CosyVoice3-0.5B

# 参考音色：3~10 秒干净人声 wav，用于 zero-shot / instruct
# 默认使用上游 CosyVoice 自带样例
COSYVOICE_PROMPT_WAV=vendor/CosyVoice/asset/zero_shot_prompt.wav

# 设备：macOS 推荐 cpu（稳定）；可试 mps（部分算子会回退 CPU）
COSYVOICE_DEVICE=cpu

# 讲故事默认指令（instruct2 模式）
COSYVOICE_STORY_INSTRUCT=You are a gentle storyteller for children. 请用温柔、缓慢、亲切的语气讲睡前故事。<|endofprompt|>
