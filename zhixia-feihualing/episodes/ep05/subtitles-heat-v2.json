[
  {
    "id": "02-poem-01",
    "text": "小暑不足畏，深居如退藏。",
    "start": 0.0,
    "end": 3.072,
    "highlight": "暑"
  },
  {
    "id": "03-poem-02",
    "text": "清风破大暑，明月转高秋。",
    "start": 5.0,
    "end": 8.24,
    "highlight": "暑"
  },
  {
    "id": "04-poem-03",
    "text": "残暑蝉催尽，新秋雁带来。",
    "start": 10.0,
    "end": 13.864,
    "highlight": "暑"
  },
  {
    "id": "05-outro",
    "text": "暑云将散，诗意未歇。第四句，你来接。",
    "start": 15.15,
    "end": 19.422,
    "highlight": "暑"
  }
]
