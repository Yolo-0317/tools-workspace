# 监听地址（局域网设备需用本机 IP，勿只用 127.0.0.1）
HOST=0.0.0.0
WS_PORT=8765
HTTP_PORT=8766

# 设备握手 token（与固件 OTA 下发一致）
TOKEN=demo-token

# LLM：ollama（本地）| deepseek（API）
LLM_BACKEND=deepseek
# 未设置时自动读取 monorepo 内 stock-ai/.env 的 DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=150
LLM_HISTORY_TURNS=8

# Ollama（LLM_BACKEND=ollama 时使用）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# ASR：tencent（推荐，每月 5000 次免费）| local（faster-whisper）
ASR_BACKEND=tencent
ASR_FALLBACK_LOCAL=true
# 腾讯云控制台 → 访问管理 → API 密钥；语音识别需开通商用版（有免费额度）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh
# TENCENT_ASR_REGION=

# local ASR（ASR_BACKEND=local 或 ASR_FALLBACK_LOCAL=true 时使用）
# fast=tiny · balanced=base（默认）· accurate=small
WHISPER_PROFILE=balanced
WHISPER_PRELOAD=true
WHISPER_BEAM_SIZE=1
# WHISPER_MODEL=$HOME/.cache/xiaozhi-whisper-base
WHISPER_DEVICE=cpu

QUARK_PICK_LLM=false
QUARK_PICK_TOP=20

# TTS：edge-tts 中文音色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 音频参数（与小智协议一致）
UPLINK_RATE=16000
DOWNLINK_RATE=24000
FRAME_MS=60
# 设备默认音量 (0-100) 与网盘流式播放增益
DEVICE_DEFAULT_VOLUME=40
STREAM_AUDIO_GAIN=2.0
# 长内容播放：0=连续播放（默认）；>0 则每 N 秒 tts.stop 开聆听窗（会卡顿，不推荐）
# STREAM_LISTEN_EVERY_S=0
# STREAM_LISTEN_WINDOW_S=1.5
# 播放中打断：true=仅唤醒词「你好小智」；false=允许直接说话打断（易误触）
# PLAYBACK_WAKE_INTERRUPT=true
# 播放记忆：每台设备独立，存 data/playback_state/
# PLAYBACK_HISTORY_LIMIT=10
# PLAYBACK_RESUME_MIN_MS=5000

# WebSocket auto/realtime：服务端按静音切轮（AtomS3R 连续推 Opus）
STREAMING_ASR=true
STREAM_SILENCE_MS=900
STREAM_MIN_SPEECH_MS=500
STREAM_MAX_UTTERANCE_MS=20000
STREAM_START_SPEECH_FRAMES=3
STREAM_MIN_RMS=0.022
STREAM_NOISE_MULTIPLIER=4.5

# Quark HTTP 流式播放（可选，见 docs/QUARK_STREAM_PLAYBACK.md）
QUARK_STREAM_ENABLED=true
# HERMES_SESSION_ID=819114eb1cc24a5da5c34bdb600fc455
# QUARK_DRIVE_CLI=/path/to/tools-workspace/.cursor/skills/quarkclouddrive/scripts/quark-drive.cjs
# QUARK_HERMES_CONFIG=/path/to/tools-workspace/.cursor/skills/quarkclouddrive/hermes/config.json

# MCP + Quark 真机播放（见 docs/MCP_QUARK_PLAYBACK.md）
# Mode A: 全本地对话网关 + Opus 推流
# USE_MCP_TOOLS=true
# bash scripts/run-quark-voice-stack.sh
#
# Cloud+HTTP（设计 DESIGN_CLOUD_HTTP_QUARK_PLAY.md）: 瘦 HTTP + 设备 play_url
# MEDIA_ONLY=true
# USE_MCP_TOOLS=false
# bash scripts/run-media-stack.sh
# bash scripts/run-media-stack.sh --with-mcp   # 需 MCP_ENDPOINT
# DEVICE_MP3_BITRATE_K=96
# DEVICE_MP3_SAMPLE_RATE=44100
# DEVICE_MP3_CHANNELS=1
#
# MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN
# XIAOZHI_GATEWAY=http://192.168.x.x:8766

# 百度网盘开放平台 — 已放弃对接（保留空项以免旧脚本报缺变量；勿再填）
# BAIDU_APP_ID=
# BAIDU_APP_KEY=
# BAIDU_SECRET_KEY=
# BAIDU_SIGN_KEY=
# BAIDU_REDIRECT_URI=http://127.0.0.1:8766/oauth/baidu/callback
# BAIDU_ACCESS_TOKEN=
# BAIDU_REFRESH_TOKEN=
