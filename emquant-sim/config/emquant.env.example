# 东财掘金量化 — 环境变量模板
# 使用：cp config/emquant.env.example .env.emquant 后填写（.env.emquant 不会提交 git）

# --- 必填（量化终端 → 系统设置 / Token 管理）---
EMQUANT_TOKEN=

# --- 必填（量化研究 → 我的策略 → 设置）---
EMQUANT_STRATEGY_ID=

# --- Mac 连 Parallels Win11 终端时必填；脚本在 Win11 本机跑可留空 ---
# 虚拟机 IP 用 ipconfig 查看，端口默认 7001
EMQUANT_SERV_ADDR=10.211.55.8:7001

# --- 仿真资金账户 ID（账户管理里复制；实盘时换成实盘账户 ID）---
EMQUANT_ACCOUNT_ID=a159f80a-5d9f-11f1-ad7c-52560acd7da0

# simulation | live（仅脚本注释用；终端界面需切到对应仿真/实盘）
EMQUANT_RUN_MODE=simulation
