# stock-ai 统一调度（supercronic + Asia/Shanghai）
# 纯 MySQL/Tushare 在容器内；OpenCLI / 微信走 run-host-job.sh → 本机 host_job_server

SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# 工作日 17:30 Tushare → MySQL（先于选股/龙头）
30 17 * * 1-5 /bin/sh /app/run_sync_daily.sh >> /app/logs/sync_daily.log 2>&1

# 工作日 17:45 选股 + SOP（本机 OpenCLI；日线 17:30 同步后）
45 17 * * 1-5 /bin/sh /app/docker/scheduler/run-host-job.sh selection >> /app/logs/selection.log 2>&1

# 工作日 18:00 收盘龙头 eod（须在 stock_daily 与选股之后 → emotion_cycle_*）
0 18 * * 1-5 /bin/sh /app/sync_emotion_cycle.sh eod >> /app/logs/emotion_cycle.log 2>&1

# 盘前 pre_market 已下线（2026-06-04）

# 盘中监控 — 已停用（2026-06-04：OpenCLI 抢 Chrome；用户不再需要）
# */5 * * * 1-5 /bin/sh /app/docker/scheduler/run-host-job.sh monitor >> /app/logs/monitor.log 2>&1

# 周五 20:30 投顾周复盘 → MySQL + 看板
30 20 * * 5 /bin/sh /app/docker/scheduler/run-host-job.sh advisor-weekly >> /app/logs/advisor_weekly.log 2>&1
