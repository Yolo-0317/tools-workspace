[
  {
    "id": "01-opening",
    "text": "飞花令，雨。",
    "start": 0.0,
    "end": 2.016,
    "highlight": "雨"
  },
  {
    "id": "02-poem-01",
    "text": "好雨知时节，当春乃发生。",
    "start": 2.016,
    "end": 5.904,
    "highlight": "雨"
  },
  {
    "id": "03-poem-02",
    "text": "清明时节雨纷纷，路上行人欲断魂。",
    "start": 5.904,
    "end": 9.96,
    "highlight": "雨"
  },
  {
    "id": "04-poem-03",
    "text": "寒雨连江夜入吴，平明送客楚山孤。",
    "start": 9.96,
    "end": 15.6,
    "highlight": "雨"
  },
  {
    "id": "05-outro",
    "text": "雨停了，诗意未歇。第四句，你来接。",
    "start": 15.75,
    "end": 20.19,
    "highlight": "雨"
  }
]
