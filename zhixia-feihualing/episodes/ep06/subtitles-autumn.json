[
  {
    "id": "01-poem-00",
    "text": "空山新雨后，天气晚来秋。",
    "start": 0.3,
    "end": 3.372,
    "highlight": "秋"
  },
  {
    "id": "02-poem-01",
    "text": "树树皆秋色，山山唯落晖。",
    "start": 5.0,
    "end": 8.864,
    "highlight": "秋"
  },
  {
    "id": "03-poem-02",
    "text": "秋风生渭水，落叶满长安。",
    "start": 11.8,
    "end": 14.848,
    "highlight": "秋"
  }
]
