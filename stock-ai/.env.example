# 复制为 .env 并填写真实值（勿提交 .env）
TUSHARE_TOKEN=

# 本机直连 MySQL（库 stock_data，服务见 ../stock-mysql/）
MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/stock_data

# Docker 定时任务（docker/scheduler）若 MySQL 在宿主机，请用：
# MYSQL_URL=mysql+pymysql://user:password@host.docker.internal:3306/stock_data

# Docker scheduler → 本机 OpenCLI 任务（见 docs/SCHEDULING.md）
# HOST_JOB_PORT=9876
# HOST_JOB_TOKEN=
# HOST_JOB_BIND=127.0.0.1

# LLM：默认 DeepSeek API（可选 LLM_BACKEND=cursor + agent login）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# 若改用 Cursor：LLM_BACKEND=cursor / CURSOR_AGENT_MODEL=auto / SOP_WORKERS=1

# 每日选股战报推送微信（push_selection_wechat.sh）
# WECHAT_PUSH_BACKEND=wechat-acp
# WECHAT_ACP_INSTANCE=tools-workspace
# WECHAT_TARGET=o9cq801H5ip_q8SH3ogvkQhhNI2s@im.wechat

# 持仓盘中监控触发推送（push_holdings_monitor.sh --push）
# FEISHU_BOT_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# HOLDINGS_ALERT_FEISHU=1
# HOLDINGS_ALERT_WECHAT=1

# 东财掘金量化（Token / 策略 ID / Parallels 终端地址）
# 东财掘金仿真量化见独立子项目 emquant-sim/（与 stock-ai 隔离）

# ── 微信公众号 API（开发者平台 + IP 白名单）────────────────────────────
# 1) https://developers.weixin.qq.com/ 绑定公众号，获取 AppSecret
# 2) 开发管理 → IP 白名单：填家里公网 IP（路由器不重启时一般不变）
# 3) 账号需完成认证后，草稿/发布接口权限才齐全（订阅号）
# WECHAT_MP_APPID=wxe98d64b124ee854e
# WECHAT_MP_SECRET=
# WECHAT_MP_WHITELIST_IP=58.37.x.x
# WECHAT_MP_PUBLIC_IP=              # 可选：固定写死公网 IP，跳过 ipify 探测
# WECHAT_MP_AUTHOR=R2D2
# WECHAT_MP_SOURCE_URL=https://hub.yoloworld.site:8883/news
# WECHAT_MP_AUTO_PUBLISH=0          # 1=草稿后直接 freepublish（建议先 0，人工审）
# WECHAT_MP_THUMB_MEDIA_ID=        # 全局兜底（四槽位默认各用各的，一般不设）
# WECHAT_MP_THUMB_NAME=机器人图     # 全局兜底文件名子串
# 四槽位封面（--list-materials 查看；默认「双封面」竖图）
# WECHAT_MP_THUMB_NAME_MARKET=封面-交易所屏-双封面
# WECHAT_MP_THUMB_NAME_TOP5=封面-手机看盘-双封面
# WECHAT_MP_THUMB_NAME_DRAGONS=封面-K线暗色-双封面
# WECHAT_MP_THUMB_NAME_WORKSPACE=封面-数据大屏-双封面
# WECHAT_MP_THUMB_MEDIA_ID_MARKET=
# WECHAT_MP_THUMB_INDEX=0
# WECHAT_MP_THUMB_UPLOAD=0
# WECHAT_MP_DRAGON_SLOT=eod        # 龙头稿读取情绪周期时段 pre_market|eod
# WECHAT_MP_DRAGON_SOP=1           # 龙头稿是否东财快采（仅公众号，不写 sop_preliminary）
# WECHAT_MP_DRAGON_SOP_MAX=3       # 龙头稿最多分析几只
# WECHAT_MP_DRAGON_SOP_CACHE_HOURS=12  # 快采缓存 output/wechat_mp_dragon_sop/日期/
# WECHAT_MP_DRAGON_SOP_WAIT=1.5    # OpenCLI 页面等待秒数
# WECHAT_MP_TOP5_SOP=1             # Top5 稿东财快采（仅 output/wechat_mp_top5_sop/）
# WECHAT_MP_TOP5_SOP_MAX=5
# WECHAT_MP_TOP5_SOP_CACHE_HOURS=12
# WECHAT_MP_TOP5_SOP_WAIT=1.5
# WECHAT_MP_TOP5_STRATEGIES=combined,five_factor,ma5,watch  # 合并候选后按总分重选 Top5
# WECHAT_MP_TOP5_SCORE_ONLY=1   # 1=按总分优先（不卡「建议动作」白名单）
# WECHAT_MP_MARKET_NEWS_HOURS=36   # 宏观稿快讯回溯小时数
# WECHAT_MP_MARKET_NEWS_LIMIT=40   # 宏观稿快讯池上限
# WECHAT_MP_MARKET_GEO_LIMIT=8     # 地缘要闻条数
# WECHAT_MP_MARKET_DOMESTIC_LIMIT=14  # 国内要闻条数
# WECHAT_MP_NEWS_SHOW_TIME=0         # 要闻是否带 17:58 钟点（默认 0=不带，更干净）

# 自检: uv run python -m scripts.tools.wechat_mp_check_whitelist
# 监控: ./scripts/install-wechat-mp-launchd.sh
# 仅看 IP: uv run python -m scripts.tools.wechat_mp_check_whitelist --show-ip
# 素材库: uv run python -m scripts.tools.wechat_mp_draft --list-materials
# 质量评分: uv run python -m scripts.tools.wechat_mp_eval --kind all
# 预览四篇: uv run python -m scripts.tools.wechat_mp_draft --dry-run
# 进草稿箱: uv run python -m scripts.tools.wechat_mp_draft   # 四槽位：优先改旧稿，再删重复
# 仅工作区技术稿: uv run python -m scripts.tools.wechat_mp_draft --kind workspace
# 只清理: uv run python -m scripts.tools.wechat_mp_draft --prune-only
# 强制新建: uv run python -m scripts.tools.wechat_mp_draft --force-new
# 监控 launchd（API 配好后）: cp ../launchd/com.user.wechat-mp-whitelist-check.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.user.wechat-mp-whitelist-check.plist
