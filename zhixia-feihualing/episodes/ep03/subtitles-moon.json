[
  {
    "id": "01-opening",
    "text": "今日飞花令｜月",
    "start": 0.0,
    "end": 2.4,
    "highlight": "月"
  },
  {
    "id": "02-poem-01",
    "text": "海上生明月，天涯共此时。",
    "start": 2.5,
    "end": 6.604,
    "highlight": "月"
  },
  {
    "id": "03-poem-02",
    "text": "举头望明月，低头思故乡。",
    "start": 6.604,
    "end": 9.868,
    "highlight": "月"
  },
  {
    "id": "04-poem-03",
    "text": "秦时明月汉时关，万里长征人未还。",
    "start": 12.38,
    "end": 17.54,
    "highlight": "月"
  },
  {
    "id": "05-outro",
    "text": "月落了诗还亮着\n第四句你来接",
    "start": 17.54,
    "end": 21.836,
    "highlight": "月"
  }
]
