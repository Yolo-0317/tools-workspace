[
  {
    "id": "01-opening",
    "text": "今日飞花令｜花",
    "start": 0.0,
    "end": 2.69,
    "highlight": "花"
  },
  {
    "id": "02-poem-01",
    "text": "夜来风雨声，花落知多少。",
    "start": 2.9,
    "end": 5.97,
    "highlight": "花"
  },
  {
    "id": "03-poem-02",
    "text": "人闲桂花落，夜静春山空。",
    "start": 6.0,
    "end": 9.86,
    "highlight": "花"
  },
  {
    "id": "04-poem-03",
    "text": "桃花潭水深千尺，\n不及汪伦送我情。",
    "start": 10.0,
    "end": 15.23,
    "highlight": "花"
  },
  {
    "id": "05-outro",
    "text": "第四句，你来接。",
    "start": 17.75,
    "end": 20.01,
    "highlight": "花"
  }
]
