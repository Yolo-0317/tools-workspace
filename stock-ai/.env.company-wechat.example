# 公司电脑 · 微信公众号写稿模式
# 复制为 stock-ai/.env 后，在本机填入真实值；此文件可提交，.env 不可提交。

# 写稿走公司电脑上的 Cursor CLI 登录态，不复制 DeepSeek API Key。
LLM_BACKEND=cursor
CURSOR_AGENT_MODEL=composer-2.5
WECHAT_MP_CURSOR_WORKSPACE=agent-workspaces/wechat-writer
WECHAT_MP_CURSOR_MAX_RETRIES=1
WECHAT_MP_CURSOR_TIMEOUT_SECONDS=420

# 微信公众平台 → 开发 → 基本配置。公司网络的公网出口 IP 必须加入白名单。
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_MP_WHITELIST_IP=
WECHAT_MP_AUTHOR=R2D2
WECHAT_MP_ACCOUNT_NAME=牛马也智能

# 公司端默认只写草稿，且不向家庭微信/飞书机器人发送通知。
WECHAT_MP_AUTO_PUBLISH=0
WECHAT_MP_NOTIFY=0
WECHAT_MP_NOTIFY_WECHAT=0
WECHAT_MP_NOTIFY_FEISHU=0
WECHAT_MP_STRICT_COMPLIANCE=1

# 写稿优先使用热搜来源；不需要 MySQL、Tushare 或 Docker。
WECHAT_MP_HOTSPOT_SOURCE=trends
WECHAT_MP_HOTSPOT_MAX_ATTEMPTS=1
WECHAT_MP_HOTSPOT_IMITATE_REWRITE=0
WECHAT_MP_TV_RESEARCH=1
WECHAT_MP_FOOTER_PRODUCT=0

# OpenCLI 由公司电脑的 Chrome 扩展提供；按本机安装位置填写。
# OPENCLI_BIN=$HOME/.nvm/versions/node/v24.14.1/bin/opencli
OPENCLI_BROWSER_SESSION=company-mp
OPENCLI_BROWSER_WINDOW=background
OPENCLI_BROWSER_IF_EXISTS=navigate
OPENCLI_BROWSER_CLOSE_TABS_ON_RELEASE=1
