# 复制为 .env 并填写真实值（勿提交 .env）
TUSHARE_TOKEN=

# 本机直连 MySQL
MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/stock

# Docker 定时任务（docker/daily-sync）若 MySQL 在宿主机，请用：
# MYSQL_URL=mysql+pymysql://user:password@host.docker.internal:3306/stock

# 每日选股战报推送微信（push_selection_wechat.sh）
