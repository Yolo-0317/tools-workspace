}

# --- Hub 聚合（english / harryputter / home-hub）---
http://hub.yoloworld.site {
	import wechat_verify
	handle {
		respond 404
	}
}

https://hub.yoloworld.site {
	import tls_le
	import wechat_verify
	import ollama_proxy
	# hub_apps（含 SillyTavern /api/backends 流式）须在 encode gzip 之前，否则外网/iPhone 看不到逐字输出甚至整段不回显
	import hub_apps
	encode gzip
	import security_headers
}

https://www.yoloworld.site {
	import tls_le
	redir https://hub.yoloworld.site{uri} permanent
}

# 微信验证兜底（IP 访问或未知 Host）
:80 {
	import wechat_verify
}

:443 {
	import tls_le
	import wechat_verify
}

# 局域网 IP 直连（mkcert；scripts/mkcert-lan-ip.sh 维护地址行）
https://192.168.1.13 { # LAN_IP_HTTPS_SITE
	tls /etc/caddy/certs/lan-ip/cert.pem /etc/caddy/certs/lan-ip/key.pem
	import ollama_proxy
	import hub_apps
	encode gzip
}
