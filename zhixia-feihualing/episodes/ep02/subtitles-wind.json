[
  {
    "id": "01-opening",
    "text": "今日飞花令｜风",
    "start": 0.0,
    "end": 2.4,
    "highlight": "风"
  },
  {
    "id": "02-poem-01",
    "text": "沾衣欲湿杏花雨，吹面不寒杨柳风。",
    "start": 2.5,
    "end": 7.732,
    "highlight": "风"
  },
  {
    "id": "03-poem-02",
    "text": "风急天高猿啸哀，渚清沙白鸟飞回。",
    "start": 7.732,
    "end": 12.148,
    "highlight": "风"
  },
  {
    "id": "04-poem-03",
    "text": "长风破浪会有时，直挂云帆济沧海。",
    "start": 12.148,
    "end": 17.212,
    "highlight": "风"
  },
  {
    "id": "05-outro",
    "text": "风停了诗还没停\n第四句你来接",
    "start": 17.212,
    "end": 21.916,
    "highlight": "风"
  }
]
