{
	# 证书由 acme.sh + 阿里云 DNS 签发，不走 80/443 HTTP 验证
	auto_https off
	# SideStore 登录走 wss provisioning_session；iOS Starscream 在 HTTP/2 下易失败
	servers :443 {
		protocols h1
	}
}

(tls_le) {
	tls /etc/caddy/certs/fullchain.cer /etc/caddy/certs/key.key
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
	}
}

(wechat_verify) {
	handle /c4de45255be91b51cd4b88b52fb77956.txt {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
}

(hub_apps) {
	# English Buddy — launchd :18787
	handle /english {
		redir * /english/ permanent
	}
	handle_path /english/* {
		reverse_proxy host.docker.internal:18787 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

    # Readalong — launchd :8791（web 静态直出；音频/manifest/API 反代 Python）
	handle /readalong {
		redir * /readalong/web/ permanent
	}
	handle /readalong/web {
		redir * /readalong/web/ permanent
	}
	handle /readalong/web/* {
		root * /readalong
		uri strip_prefix /readalong
		header Cache-Control "no-cache" /web/index.html
		header Cache-Control "no-cache" /web/sw.js
		file_server
	}
	handle_path /readalong/* {
		reverse_proxy host.docker.internal:8791 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Home Hub — launchd :8780
	handle /hub {
		redir * /hub/ permanent
	}
	handle_path /hub/* {
		reverse_proxy host.docker.internal:8780 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 兼容旧前端 /api/*（勿 301：POST 跟重定向会变 GET → 登录报 Not Found）
	handle /api/* {
		reverse_proxy host.docker.internal:8780 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	@legacy_hub {
		not path /english /english/* /readalong /readalong/* /hub /hub/*
		not path /c4de45255be91b51cd4b88b52fb77956.txt
	}
	handle @legacy_hub {
		redir * /hub{uri} permanent
	}
}

# --- SideStore ---
https://ani.yoloworld.site {
	import tls_le
	# SideStore 登录走 wss /v3/provisioning_session，勿对 WebSocket 开 gzip
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy anisette:6969 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}
	handle {
		reverse_proxy anisette:6969 {
			transport http {
				read_timeout 60s
			}
		}
	}
	import security_headers
}

https://config.yoloworld.site {
	import tls_le
	encode gzip
	handle /servers.json {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	handle {
		respond 404
	}
}

# --- 媒体 / 订阅 ---
https://alist.yoloworld.site {
	import tls_le
	@jellyfin path /jellyfin /jellyfin/*
	handle @jellyfin {
		reverse_proxy host.docker.internal:8096 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		redir /jellyfin permanent
	}
	import security_headers
}

https://sub.yoloworld.site {
	import tls_le
	encode gzip
	handle /sub-store/* {
		uri strip_prefix /sub-store
		reverse_proxy host.docker.internal:3001 {
			transport http {
				read_timeout 120s
			}
		}
	}
	handle /clash-verge.yaml {
		reverse_proxy host.docker.internal:8787 {
			transport http {
				read_timeout 120s
			}
		}
		header Cache-Control "no-cache, no-store, must-revalidate"
	}
	handle /clash.yaml {
		reverse_proxy host.docker.internal:8787 {
			transport http {
				read_timeout 120s
			}
		}
		header Cache-Control "no-cache, no-store, must-revalidate"
	}
	handle {
		redir /clash.yaml permanent
	}
	import security_headers
}

# --- Hub 聚合（english / readalong / home-hub）---
http://hub.yoloworld.site {
	import wechat_verify
	handle {
		respond 404
	}
}

https://hub.yoloworld.site {
	import tls_le
	encode gzip
	import wechat_verify
	import hub_apps
	import security_headers
}

https://www.yoloworld.site {
	import tls_le
	redir https://hub.yoloworld.site{uri} permanent
}

# 微信验证兜底（IP 访问或未知 Host）
:80 {
	import wechat_verify
}

:443 {
	import tls_le
	import wechat_verify
}

# 局域网 IP 直连（mkcert；scripts/mkcert-lan-ip.sh 维护地址行）
https://192.168.1.13 { # LAN_IP_HTTPS_SITE
	tls /etc/caddy/certs/lan-ip/cert.pem /etc/caddy/certs/lan-ip/key.pem
	encode gzip
	import hub_apps
}
