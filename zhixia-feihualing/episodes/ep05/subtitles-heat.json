[
  {
    "id": "02-poem-01",
    "text": "南州溽暑醉如酒，隐几熟眠开北牖。",
    "start": 1.152,
    "end": 6.403,
    "highlight": "暑"
  },
  {
    "id": "03-poem-02",
    "text": "离离暑云散，袅袅凉风起。",
    "start": 6.283,
    "end": 9.048,
    "highlight": "暑"
  },
  {
    "id": "04-poem-03",
    "text": "残暑蝉催尽，新秋雁戴来。",
    "start": 11.158,
    "end": 14.864,
    "highlight": "暑"
  },
  {
    "id": "05-outro",
    "text": "暑云将散，诗意未歇。第四句，你来接。",
    "start": 16.401,
    "end": 20.482,
    "highlight": "暑"
  }
]
